<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#44FF6A00" />
            <stroke android:width="3dp" android:color="#FF6A00" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FF6A00" />
            <stroke android:width="1dp" android:color="#FF6A00" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
